extends SceneTree
## tools/make_particle_textures.gd — the source of res://effects/textures/chip_6.png and
## res://effects/textures/soft_dot_32.png (CHANGE-BRIEF.md, Effect A "Textures").
## Both PNGs are generated by this code with Image: not sourced, not AI-generated. No randomness,
## so a rerun writes identical files. White RGB, so the emitters' color_ramp sets the colour.
## Run: <godot_console.exe> --headless --path . --script res://tools/make_particle_textures.gd

const OUT_DIR := "res://effects/textures"
const CHIP_PATH := OUT_DIR + "/chip_6.png"
const DOT_PATH := OUT_DIR + "/soft_dot_32.png"

const CHIP_SIZE := 6
## A fixed lopsided pentagon in pixel units (0..6); a pixel is inside if its centre is.
const CHIP_POLYGON := [
	Vector2(0.1, 2.0),
	Vector2(3.2, 0.2),
	Vector2(5.8, 1.8),
	Vector2(5.2, 5.0),
	Vector2(1.2, 5.6),
]

const DOT_SIZE := 32
const DOT_RADIUS := 16.0


func _initialize() -> void:
	var err := DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	if err != OK:
		print("ERROR: could not create %s (%d)" % [OUT_DIR, err])
		quit(1)
		return
	if not _save(_make_chip(), CHIP_PATH):
		quit(1)
		return
	if not _save(_make_soft_dot(), DOT_PATH):
		quit(1)
		return
	quit(0)


func _make_chip() -> Image:
	var poly := PackedVector2Array(CHIP_POLYGON)
	var img := Image.create(CHIP_SIZE, CHIP_SIZE, false, Image.FORMAT_RGBA8)
	for y in CHIP_SIZE:
		for x in CHIP_SIZE:
			var inside := Geometry2D.is_point_in_polygon(Vector2(x + 0.5, y + 0.5), poly)
			img.set_pixel(x, y, Color(1, 1, 1, 1.0 if inside else 0.0))
	return img


func _make_soft_dot() -> Image:
	var centre := Vector2(DOT_SIZE, DOT_SIZE) * 0.5
	var img := Image.create(DOT_SIZE, DOT_SIZE, false, Image.FORMAT_RGBA8)
	for y in DOT_SIZE:
		for x in DOT_SIZE:
			var d := Vector2(x + 0.5, y + 0.5).distance_to(centre)
			img.set_pixel(x, y, Color(1, 1, 1, 1.0 - smoothstep(0.0, DOT_RADIUS, d)))
	return img


## Saves img as PNG, reads the file back and prints its path, pixel size and byte size.
func _save(img: Image, path: String) -> bool:
	var abs_path := ProjectSettings.globalize_path(path)
	var err := img.save_png(abs_path)
	if err != OK:
		print("ERROR: save_png failed for %s (%d)" % [path, err])
		return false
	var back := Image.load_from_file(abs_path)
	if back == null:
		print("ERROR: could not read back ", path)
		return false
	var bytes := FileAccess.get_file_as_bytes(abs_path).size()
	print("wrote %s  size %dx%d  format %d  %d bytes" % [path, back.get_width(), back.get_height(), back.get_format(), bytes])
	return true
